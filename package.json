{
  "name": "english-speaking-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Memory-only browser prototype for short English speaking practice.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs dist",
    "dev": "node scripts/serve.mjs .",
    "lint": "node scripts/lint.mjs",
    "typecheck": "npx --yes typescript@6.0.3 tsc -p tsconfig.json",
    "test": "node --test tests/recorder.test.js tests/content.test.js",
    "check": "npm run lint && npm run test && npm run build"
  }
}
